<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CinemaProject</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CinemaProject.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
            <div class="container-fluid">
                <a class="navbar-brand" href="#">CinemaMePhim</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNavDropdown">
                    <!-- Bên trái -->
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Lịch Chiếu</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Hôm nay</a></li>
                                <li><a class="dropdown-item" href="#">Tuần này</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Phim</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Đang chiếu</a></li>
                                <li><a class="dropdown-item" href="#">Sắp chiếu</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link " href="@Url.Action("Community", "CinemaView")">Cộng Đồng</a>
                        </li>
                    </ul>

                    <!-- Bên phải -->
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <form class="d-flex align-items-center" asp-controller="CinemaView" asp-action="Search" method="get">
                                <input class="form-control me-2" type="search" name="query" placeholder="Tìm kiếm phim..." aria-label="Search" style="width: 250px;">
                                <button class="btn btn-sm btn-outline-light" type="submit">Tìm</button>
                            </form>
                        </li>
                        @if (Context.Session.GetString("username") == null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="CinemaView" asp-action="Login">Đăng nhập</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <form asp-controller="CinemaView" asp-action="Logout" method="post" style="display:inline;">
                                    <button type="submit" class="btn btn-link nav-link" style="color:white; text-decoration:none;">Đăng xuất</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>


    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer>
        <p>&copy; 2025 - CinemaMePhim. All rights reserved.</p>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
