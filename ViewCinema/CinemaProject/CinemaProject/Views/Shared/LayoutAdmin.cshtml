<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Admin Panel</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/Admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CinemaProject.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-3 sidebar">
                <h4>Quản trị</h4>
                <a href="@Url.Action("#", "NhanVien")">Quản lí nhân viên</a>
                <a href="@Url.Action("Movie", "CinemaAdmin")">Kho phim</a>
                <a href="@Url.Action("#", "DanhMucPhim")">Danh mục phim</a>
                <a href="@Url.Action("bookve")">Giá vé</a>
                <a href="@Url.Action("#", "Phong")">Phòng</a>
                <a href="@Url.Action("KhachHang")">Quản lí khách hàng</a>
                <a href="@Url.Action("#", "DoAn")">Đồ ăn - Thức uống</a>
                <!-- Bên phải -->
                <ul class="navbar-nav ms-auto">
                    @if (Context.Session.GetString("username") == null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="CinemaView" asp-action="Login">Đăng nhập</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <form asp-controller="CinemaView" asp-action="Logout" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-link nav-link" style="color:white; text-decoration:none;">Đăng xuất</button>
                            </form>
                        </li>
                    }
                </ul>
            </div>

            <!-- Content -->
            <div class="col-md-9 content">
                @RenderBody()
            </div>

        </div>
    </div>
</body>
</html>
