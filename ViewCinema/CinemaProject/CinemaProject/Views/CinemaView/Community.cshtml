    <script>
        document.querySelectorAll('.heart-icon').forEach(function (icon) {
            icon.addEventListener('click', function () {
                this.classList.toggle('liked');
            });
        });

        document.querySelectorAll('.reaction i').forEach(icon => {
            icon.addEventListener('click', function () {
                const type = this.classList.contains('fa-thumbs-up') ? 'like'
                    : this.classList.contains('fa-thumbs-down') ? 'dislike'
                        : 'share';

                const id = this.dataset.id;

                fetch('/CinemaView/React', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ id, type })
                })
                    .then(res => {
                        if (res.ok) {
                            this.classList.add('text-success'); // thêm màu xanh
                            setTimeout(() => this.classList.remove('text-success'), 1000);
                        }
                    });
            });
        });
    </script>
</body>
</html>
