                <i class="fas fa-user-circle"></i> Đào Diệu Loan <small>- Phóng viên tự do</small>
            </a>

            <a href="@Url.Action("CriticDetail", "CinemaView", new { name = "Hanhfm" })" class="critic">
                <i class="fas fa-user-circle"></i> Hanhfm <small>- Nhà phê bình tự do</small>
            </a>

            <a href="@Url.Action("CriticDetail", "CinemaView", new { name = "Hoàng Hưng" })" class="critic">
