@model IEnumerable<CinemaProject.Models.Phim>
@{
    ViewData["Title"] = "Danh sách phim";
}

<div class="container">
    <h2 class="text-white">Danh sách phim</h2>
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var p in Model)
        {
            <div class="col">
                <div class="card h-100 bg-dark text-white">
                    <img src="@Url.Content($"~/images/{p.IdPhim}.jpg?v={DateTime.Now.Ticks}")"
                         class="card-img-top" alt="@p.TenPhim"
                         style="height: 350px; object-fit: cover;" />
                    <div class="card-body">
                        <h5 class="card-title">
                            <a asp-controller="CinemaView" asp-action="ChiTiet" asp-route-id="@p.IdPhim" class="text-white text-decoration-none">
                                @p.TenPhim
                            </a>
                        </h5>
                        <p class="card-text">Thời lượng: @p.ThoiLuong phút</p>
                        <p class="card-text">Ngày khởi chiếu: @p.NgayKhoiChieu?.ToString("dd/MM/yyyy")</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
