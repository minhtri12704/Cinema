@model CinemaProject.Models.ChonBapNuocViewModel
@using System.Text.Json
@using CinemaProject.Models
@using System.Linq
@{
    ViewData["Title"] = "Chọn bắp nước";
    var comboDataJson = JsonSerializer.Serialize((List<ComboMonAn>)Model.Combos);
    var monDataJson = JsonSerializer.Serialize((List<MonAnvaThucUong>)Model.MonLe);
}

<style>
    .btn-quantity {
        width: 40px;
        height: 40px;
        font-weight: bold;
        font-size: 20px;
        border-radius: 50%;
        background-color: #f0f0f0 !important;
        color: black !important;
        border: 1px solid #ccc;
        transition: all 0.2s ease;
    }

        .btn-quantity:hover {
            background-color: #e0e0e0 !important;
            box-shadow: 0 0 5px rgba(0,0,0,0.2);
        }

    .quantity-control {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .quantity-display {
        width: 60px;
        height: 40px;
        text-align: center;
        font-size: 18px;
        font-weight: bold;
        border-radius: 10px;
        background-color: white;
        color: black;
    }

    .table-custom th, .table-custom td {
        vertical-align: middle;
        color: white;
    }

    .table-custom {
        background-color: #2c2c2c;
        border-radius: 10px;
        overflow: hidden;
    }

    .table-wrapper {
        margin-bottom: 40px;
    }
</style>

<div class="d-flex justify-content-between align-items-center px-3 border-top border-bottom border-primary" style="margin-top: 80px">

    @{
        var steps = new[] { "Chọn ghế", "Bắp nước", "Thanh toán", "Thông tin vé" };
        int currentStep = ViewBag.CurrentStep ?? 0;
        for (int i = 0; i < steps.Length; i++)
        {
            <div class="text-center">
                <div class="rounded-circle @(i == currentStep ? "bg-danger" : "bg-secondary") text-white p-3 fw-bold">@(i + 1)</div>
                <small class="d-block mt-1 text-white">@steps[i]</small>
            </div>
            if (i < steps.Length - 1)
            {
                <div class="border-top border-white flex-grow-1 mx-2"></div>
            }
        }
    }

</div>
<div class="container text-white">
    <div class="row">
        <!-- PHẦN 7: COMBO + MÓN ĂN -->
        <div class="col-md-9">
            <!-- Combo -->
            <div class="table-wrapper">
                <h4 class="mb-3">🍿 Danh sách Combo</h4>
                <table class="table table-bordered table-custom">
                    <thead>
                        <tr>
                            <th>Tên Combo</th>
                            <th>Giá</th>
                            <th>Số lượng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var combo in Model.Combos)
                        {
                            <tr>
                                <td>@combo.CacMonAn</td>
                                <td>@(((decimal)combo.GiaTien).ToString("N0"))₫</td>
                                <td>
                                    <div class="quantity-control">
                                        <button class="btn btn-danger btn-quantity" onclick="adjustQuantity('combo', '@combo.IdMonAn', -1)">-</button>
                                        <input type="text" class="form-control quantity-display" id="combo-@combo.IdMonAn" value="0" readonly />
                                        <button class="btn btn-success btn-quantity" onclick="adjustQuantity('combo', '@combo.IdMonAn', 1)">+</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Món lẻ -->
            <div class="table-wrapper">
                <h4 class="mb-3">🥤 Đồ ăn & Thức uống riêng lẻ</h4>
                <table class="table table-bordered table-custom">
                    <thead>
                        <tr>
                            <th>Tên món</th>
                            <th>Giá</th>
                            <th>Số lượng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var mon in Model.MonLe)
                        {
                            <tr>
                                <td>@mon.TenMon</td>
                                <td>@mon.Gia.ToString("N0")₫</td>
                                <td>
                                    <div class="quantity-control">
                                        <button class="btn btn-danger btn-quantity" onclick="adjustQuantity('mon', '@mon.MaMon', -1)">-</button>
                                        <input type="text" class="form-control quantity-display" id="mon-@mon.MaMon" value="0" readonly />
                                        <button class="btn btn-success btn-quantity" onclick="adjustQuantity('mon', '@mon.MaMon', 1)">+</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- PHẦN 3: THÔNG TIN VÉ -->
        <div class="col-md-3">
            <div class="bg-dark p-4 rounded text-white sticky-top" style="top: 100px;">
                <h4 class="mb-3">🎟 Thông tin vé</h4>
                <p><strong>🎬 Phim:</strong> @Model.TenPhim</p>
                <p><strong>🏢 Rạp:</strong> @Model.TenRap</p>
                <p><strong>🛋 Phòng:</strong> @Model.TenPhong</p>
                <p><strong>🕒 Suất:</strong> @Model.GioChieu</p>
                <p>
                    <strong>Ghế đã chọn:</strong> @(Model.GheDaChon != null && Model.GheDaChon.Any()
                    ? string.Join(", ", Model.GheDaChon)
                    : "Chưa chọn")
                </p>
                <hr />
                <form method="post" asp-action="ThanhToan" asp-controller="DatVe">
                    <input type="hidden" id="ComboDaChon" name="ComboDaChon" value="" />
                    <input type="hidden" id="MonLeDaChon" name="MonLeDaChon" value="" />
                    <input type="hidden" name="idLich" value="@Model.IdLich" />
                    <input type="hidden" name="selectedSeats" value="@string.Join(",", Model.GheDaChon)" />

                    <button type="submit" class="btn btn-primary">Tiếp tục</button>
                </form>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        const comboData = @Html.Raw(comboDataJson);
        const monData = @Html.Raw(monDataJson);
        const tongTienSpan = document.getElementById("tongTien");

        function adjustQuantity(type, id, delta) {
            const input = document.getElementById(`${type}-${id}`);
            let qty = parseInt(input.value);
            qty = isNaN(qty) ? 0 : qty + delta;
            qty = Math.max(0, qty);
            input.value = qty;

            updateTotal();
            updateSelectedItems();
        }

        function updateTotal() {
            let total = @Model.TongTienGhe;

            comboData.forEach(c => {
                let input = document.getElementById(`combo-${c.IdMonAn}`);
                let qty = input ? parseInt(input.value) : 0;
                if (!isNaN(qty) && qty > 0) {
                    total += qty * c.GiaTien;
                }
            });

            monData.forEach(m => {
                let input = document.getElementById(`mon-${m.MaMon}`);
                let qty = input ? parseInt(input.value) : 0;
                if (!isNaN(qty) && qty > 0) {
                    total += qty * m.Gia;
                }
            });

            if (tongTienSpan) {
                tongTienSpan.innerText = total.toLocaleString("vi-VN") + "₫";
            }
        }

        function updateSelectedItems() {
            const selectedCombos = [];
            const selectedMons = [];

            comboData.forEach(c => {
                let input = document.getElementById(`combo-${c.IdMonAn}`);
                let qty = input ? parseInt(input.value) : 0;
                if (!isNaN(qty) && qty > 0) {
                    selectedCombos.push(`${c.IdMonAn}:${qty}`);
                }
            });

            monData.forEach(m => {
                let input = document.getElementById(`mon-${m.MaMon}`);
                let qty = input ? parseInt(input.value) : 0;
                if (!isNaN(qty) && qty > 0) {
                    selectedMons.push(`${m.MaMon}:${qty}`);
                }
            });

            const comboInput = document.getElementById("ComboDaChon");
            const monInput = document.getElementById("MonLeDaChon");

            if (comboInput) comboInput.value = selectedCombos.join("|");
            if (monInput) monInput.value = selectedMons.join("|");
        }

        // Khi người dùng nhấn submit form
        document.addEventListener("DOMContentLoaded", () => {
            updateTotal();
            updateSelectedItems();

            const form = document.querySelector("form");
            if (form) {
                form.addEventListener("submit", () => {
                    updateSelectedItems(); // đảm bảo dữ liệu cập nhật trước khi gửi
                });
            }
        });
    </script>
}



