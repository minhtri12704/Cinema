@model CinemaProject.Models.Phim
@{
    ViewData["Title"] = "Chi tiết phim";
}
<div class="container text-white mt-5 pt-4">
    <div class="row pt-4">
        <div class="col-md-4">
            <img src="~/images/@Model.HinhAnh"
                 class="card-img-top"
                 alt="@Model.TenPhim"
                 style="height: 400px; object-fit: cover;"
                 onerror="this.onerror=null;this.src='@Url.Content("~/images/no-image.jpg")';" />
        </div>

        <div class="col-md-8">
            <h2>@Model.TenPhim</h2>
            <p><strong>Thể loại:</strong> @string.Join(", ", (List<string>)ViewBag.TenTheLoais)</p>
            <p><strong>Thời lượng:</strong> @Model.ThoiLuong phút</p>
            <p><strong>Ngày khởi chiếu:</strong> @Model.NgayKhoiChieu?.ToString("dd/MM/yyyy")</p>
            <p><strong>Độ tuổi phù hợp:</strong> @Model.DoTuoiPhuHop</p>
            <div class="d-flex gap-2 mt-3">               
                <button class="btn btn-outline-warning">
                    👍 Thích
                </button>

                <button class="btn btn-outline-info" onclick="switchToReviewTab()">
                    💬 Bình luận
                </button>

            </div>

        </div>
    </div>
</div>

<ul class="nav nav-tabs mt-5" id="filmTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link " id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button" role="tab">
            Thông tin phim
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link " id="lich-tab" data-bs-toggle="tab" data-bs-target="#lich" type="button" role="tab">
            Lịch chiếu
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="review-tab" data-bs-toggle="tab" data-bs-target="#review" type="button" role="tab">
            Đánh giá
        </button>
    </li>
</ul>

<div class="tab-content p-3 bg-dark text-white border border-top-0" id="filmTabContent">
    <div class="tab-pane fade " id="info" role="tabpanel">
        <p>@Model.TenPhim là một bộ phim thuộc thể loại @Model.IdTheLoai.</p>
        <!-- Thêm mô tả tùy ý -->
    </div>
    <div class="tab-pane fade " id="lich" role="tabpanel" aria-labelledby="lich-tab">
        @if (ViewBag.LichChieus is List<LichChieu> lichList && lichList.Any())
        {
            var groupedByDate = lichList.GroupBy(l => l.NgayChieu);

            @foreach (var group in groupedByDate)
            {
                <h5 class="text-info mt-4 fw-bold border-bottom border-info pb-2">
                    📅 Ngày chiếu: @group.Key.ToString("dd/MM/yyyy")
                </h5>
                <div class="row row-cols-1 g-3">
                    @foreach (var lc in group)
                    {
                        <div class="col">
                            <div class="card shadow-sm border-primary">
                                <div class="card-body bg-light d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
                                    <div>
                                        <h6 class="card-title text-primary mb-1">Vị trí: @lc.IdPhongNavigation?.TenPhong</h6>
                                        <p class="card-subtitle text-muted mb-0 fs-5" style="color:blue">
                                            🏢 Rạp: @lc.IdPhongNavigation?.IdRapNavigation?.TenRap
                                        </p>
                                    </div>
                                    <div class="mt-2 mt-md-0 d-flex flex-column flex-md-row gap-3 align-items-start align-items-md-center">
                                        <span class="text-dark fw-semibold">🕒 @lc.GioChieu</span>
                                        <a asp-controller="DatVe" asp-action="DatGhe" asp-route-id="@lc.IdLich" class="btn btn-danger">
                                            Đặt vé ngay
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <p class="text-warning">Hiện chưa có lịch chiếu cho phim này.</p>
        }
    </div>

    <div class="tab-pane fade show active" id="review" role="tabpanel">
        @if (ViewBag.DanhGias is List<DanhGiaPhim> danhGiaList && danhGiaList.Any())
        {
            @foreach (var dg in danhGiaList)
            {
                var currentUserId = Context.Session.GetString("idKhach");
                bool isOwner = currentUserId == dg.IdKhach;

                <div class="border-bottom pb-2 mb-2 position-relative">
                    <strong>@dg.KhachHangNavigation?.Ten</strong>
                    <span class="text-muted">(@dg.NgayDanhGia.ToString("dd/MM/yyyy"))</span>

                    <div>
                        @for (int i = 0; i < dg.SoSao; i++)
                        {
                            <span style="color:gold;">&#9733;</span>
                        }
                    </div>

                    <p>@dg.BinhLuan</p>

                    @* Nếu người dùng là chủ bình luận thì hiện nút ba chấm *@
                    @if (isOwner)
                    {
                        <div class="dropdown position-absolute top-0 end-0">
                            <button class="btn btn-sm btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                ⋮
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <button type="button"
                                            class="dropdown-item text-danger"
                                            onclick="openEditModal('@dg.IdDanhGia', `@dg.BinhLuan.Replace("`", "\\`")`, @dg.SoSao)">
                                        ✏️ Chỉnh sửa
                                    </button>

                                </li>
                                <li>
                                    <form method="post" asp-action="XoaBinhLuan" asp-controller="CinemaView" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bình luận này không?');">
                                        <input type="hidden" name="idDanhGia" value="@dg.IdDanhGia" />
                                        <button type="submit" class="dropdown-item text-warning">
                                            🗑️ Xóa
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <p>Chưa có đánh giá nào.</p>
        }
        @if (Context.Session.GetString("idKhach") != null)
        {
            <div id="commentBox" class="mt-4">
                <h5 class="text-white">Viết bình luận:</h5>
                <form method="post" asp-controller="CinemaView" asp-action="ThemBinhLuan">
                    <input type="hidden" name="IdPhim" value="@Model.IdPhim" />
                    <div class="mb-2">
                        <div id="starRating" class="d-flex gap-1">
                            @for (int i = 1; i <= 10; i++)
                            {
                                <span class="star fs-4" data-value="@i">&#9733;</span>
                            }
                        </div>
                        <input type="hidden" name="SoSao" id="SoSao" required />
                    </div>

                    <div class="mb-2">
                        <textarea name="BinhLuan" class="form-control" rows="3" placeholder="Nhập bình luận..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Gửi</button>
                </form>
            </div>
        }
        else
        {
            <p class="text-warning mt-4">Bạn cần <a href="/CinemaView/Login" class="text-info">đăng nhập</a> để viết bình luận.</p>
        }
    </div>
</div>  
<!-- Modal chỉnh sửa bình luận -->
<div class="modal fade" id="editCommentModal" tabindex="-1" aria-labelledby="editCommentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-white">
            <div class="modal-header">
                <h5 class="modal-title" id="editCommentModalLabel">✏️ Chỉnh sửa bình luận</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-controller="CinemaView" asp-action="ChinhSuaBinhLuan">
                <div class="modal-body">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="editCommentId" />
                    <div class="mb-3">
                        <label class="form-label">Bình luận</label>
                        <textarea name="BinhLuan" id="editCommentContent" class="form-control" rows="3" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label d-block">Số sao</label>
                        <div id="editStarRating" class="d-flex gap-1">
                            @for (int i = 1; i <= 10; i++)
                            {
                                <span class="edit-star fs-4" data-value="@i">&#9733;</span>
                            }
                        </div>
                        <input type="hidden" name="SoSao" id="editSoSao" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                </div>
            </form>
        </div>
    </div>
</div>



<script>
    const stars = document.querySelectorAll('#starRating .star');
    const ratingInput = document.getElementById('SoSao');

    stars.forEach((star, index) => {
        // Hover effect
        star.addEventListener('mouseover', () => {
            resetStars();
            for (let i = 0; i <= index; i++) {
                stars[i].classList.add('hover');
            }
        });

        // Remove hover on mouseout
        star.addEventListener('mouseout', () => {
            resetStars();
        });

        // Click to select
        star.addEventListener('click', () => {
            ratingInput.value = star.dataset.value;
            stars.forEach(s => s.classList.remove('selected'));
            for (let i = 0; i <= index; i++) {
                stars[i].classList.add('selected');
            }
        });
    });

    function resetStars() {
        stars.forEach(star => {
            star.classList.remove('hover');
        });
    }
    function switchToReviewTab() {
        const reviewTab = new bootstrap.Tab(document.querySelector('#review-tab'));
        reviewTab.show();

        // Cuộn đến khung viết bình luận
        const commentBox = document.getElementById('commentBox');
        if (commentBox) {
            commentBox.scrollIntoView({ behavior: 'smooth' });
        }
    }
</script>

<script>
    function openEditModal(id, binhLuan, soSao) {
        document.getElementById("editCommentId").value = id;
        document.getElementById("editCommentContent").value = binhLuan;
        document.getElementById("editSoSao").value = soSao;

        updateEditStars(soSao);

        const modal = new bootstrap.Modal(document.getElementById('editCommentModal'));
        modal.show();
    }

    const editStars = document.querySelectorAll('#editStarRating .edit-star');
    const editRatingInput = document.getElementById('editSoSao');

    editStars.forEach((star, index) => {
        // Hover effect
        star.addEventListener('mouseover', () => {
            resetEditStars();
            for (let i = 0; i <= index; i++) {
                editStars[i].classList.add('hover');
            }
        });

        star.addEventListener('mouseout', () => {
            resetEditStars();
            updateEditStars(editRatingInput.value);
        });

        // Click to select
        star.addEventListener('click', () => {
            editRatingInput.value = star.dataset.value;
            updateEditStars(editRatingInput.value);
        });
    });

    function resetEditStars() {
        editStars.forEach(star => star.classList.remove('hover', 'selected'));
    }

    function updateEditStars(selectedValue) {
        resetEditStars();
        for (let i = 0; i < selectedValue; i++) {
            editStars[i].classList.add('selected');
        }
    }
</script>



<style>
    .star {
        cursor: pointer;
        color: gray;
        transition: color 0.2s;
    }

        .star.hover,
        .star.selected {
            color: gold;
        }

    .edit-star {
        cursor: pointer;
        color: gray;
        transition: color 0.2s;
    }

        .edit-star.hover,
        .edit-star.selected {
            color: gold;
        }
</style>
