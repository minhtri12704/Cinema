@model CinemaProject.Models.NhanVien

@{
    Layout = "~/Views/Shared/LayoutAdmin.cshtml";
}

<style>
    .form-container {
        width: 50%;
        margin: 50px auto;
        background-color: #2c2c2c;
        padding: 30px;
        border-radius: 10px;
        color: white;
    }

    label {
        font-weight: bold;
        font-size: 20px;
    }

    input.form-control {
        font-size: 18px;
    }

    .btn-primary {
        background-color: #ff69b4;
        border: none;
    }

    .btn-secondary {
        margin-left: 10px;
    }
</style>

<div class="form-container">
    <h2 class="text-center mb-4">Thêm thông tin khách hàng</h2>

    <form asp-action="AddNV" asp-controller="CinemaAdmin" method="post">
        @* <input type="hidden" asp-for="IdNhanVien" /> *@

        <div class="mb-3">
            <label asp-for="IdNhanVien" class="form-label">Mã Nhân Viên</label>
            <input asp-for="IdNhanVien" class="form-control" />
            <span asp-validation-for="IdNhanVien" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="IdRap" class="form-label">Mã Rạp</label>
            <input asp-for="IdRap" class="form-control" />
            <span asp-validation-for="IdRap" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Ten" class="form-label">Họ tên</label>
            <input asp-for="Ten" class="form-control" />
            <span asp-validation-for="Ten" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ViTri" class="form-label">Vị Trí</label>
            <input asp-for="ViTri" class="form-control" />
            <span asp-validation-for="ViTri" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Luong" class="form-label">Lương</label>
            <input asp-for="Luong" class="form-control" />
            <span asp-validation-for="Luong" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NgayVaoLam" class="form-label"> Ngày Vào làm</label>
            <input asp-for="NgayVaoLam" class="form-control" type="date" />
            <span asp-validation-for="NgayVaoLam" class="text-danger"></span>
        </div>

        <div class="text-center">
            <button type="submit" class="btn btn-primary">Thêm Nhân Viên</button>
            @* <a asp-action="NhanVien" class="btn btn-secondary">Quay lại</a> *@
        </div>
    </form>
</div>
