@model IEnumerable<CinemaProject.Models.PhongChieu>
@{
    Layout = "~/Views/Shared/LayoutAdmin.cshtml";
}

<h2>Danh sách phòng chiếu</h2>

<a href="@Url.Action("CreatePhongChieu")" class="btn btn-primary mb-3">Thêm phòng chiếu</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Rạp</th>
            <th>Tên phòng</th>
            <th>Tổng lượng ghế</th>
            <th>Ghế đôi</th>
            <th>Ghế Vip</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdRapNavigation?.TenRap</td>
                <td>@item.TenPhong</td>
                <td>@item.SoLuongGhe</td>
                <td>@item.SoLuongGheDoi</td>
                <td>@item.SoLuongGheVip</td>
                <td>
                    <a asp-action="EditPhongChieu" asp-route-id="@item.IdPhong">Sửa</a> |
                    <a asp-action="DeletePhongChieu" asp-route-id="@item.IdPhong" onclick="return confirm('Xoá phòng này?');">Xoá</a>
                </td>
            </tr>
        }
    </tbody>
</table>

