@model CinemaProject.Models.Phim
@{
    ViewData["Title"] = "Thêm phim mới";
    Layout = "~/Views/Shared/LayoutAdmin.cshtml";
}

<h2>Thêm phim mới</h2>

<form asp-action="Create" asp-controller="CinemaAdmin" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="IdPhim">Mã phim</label>
        <input asp-for="IdPhim" class="form-control" />
        <span asp-validation-for="IdPhim" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="TenPhim">Tên phim</label>
        <input asp-for="TenPhim" class="form-control" />
        <span asp-validation-for="TenPhim" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="IdTheLoai">Thể loại</label>
        <select id="theLoaiSelect" class="form-control" multiple size="8">
            @foreach (var theLoai in ViewBag.IdTheLoai as List<SelectListItem>)
            {
                <option value="@theLoai.Value">@theLoai.Text</option>
            }
        </select>
        <button type="button" class="btn btn-sm btn-primary mt-2" onclick="layTheLoai()">Xác nhận</button>
        <input type="text" id="IdTheLoai" name="IdTheLoai" class="form-control mt-2" readonly />

        <span asp-validation-for="IdTheLoai" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ThoiLuong">Thời lượng (phút)</label>
        <input asp-for="ThoiLuong" class="form-control" />
        <span asp-validation-for="ThoiLuong" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="NgayKhoiChieu">Ngày khởi chiếu</label>
        <input asp-for="NgayKhoiChieu" type="date" class="form-control" />
        <span asp-validation-for="NgayKhoiChieu" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DoTuoiPhuHop">Độ tuổi phù hợp</label>
        <input asp-for="DoTuoiPhuHop" class="form-control" />
        <span asp-validation-for="DoTuoiPhuHop" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Hình ảnh phim</label>
        <input type="file" name="HinhAnhFile" class="form-control" accept=".jpg,.jpeg,.png" required />
    </div>

    <div class="form-group">
        <label asp-for="MoTa">Mô tả phim</label>
        <textarea asp-for="MoTa" class="form-control" rows="4"></textarea>
        <span asp-validation-for="MoTa" class="text-danger"></span>
    </div>



    <button type="submit" class="btn btn-primary">Thêm phim</button>
    <a asp-action="Home" asp-controller="CinemaAdmin" class="btn btn-secondary">Hủy</a>
</form>

@section Scripts {
    <script>
        function layTheLoai() {
            const selected = Array.from(document.getElementById("theLoaiSelect").selectedOptions)
                .map(o => o.value)
                .filter(v => v !== "");

            document.getElementById("IdTheLoai").value = selected.join(',');
        }
    </script>
}
