@model CinemaProject.Models.Phim
@{
    ViewData["Title"] = "Chỉnh sửa phim";
    Layout = "~/Views/Shared/LayoutAdmin.cshtml";
}

<h2>Chỉnh sửa thông tin phim</h2>

<form asp-action="EditPhim" asp-controller="CinemaAdmin" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="IdPhim">Mã phim</label>
        <input asp-for="IdPhim" class="form-control" readonly />
    </div>

    <div class="form-group">
        <label asp-for="TenPhim">Tên phim</label>
        <input asp-for="TenPhim" class="form-control" />
        <span asp-validation-for="TenPhim" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="IdTheLoai">Thể loại</label>
        <select id="theLoaiSelect" class="form-control" multiple size="8">
            @foreach (var theLoai in ViewBag.IdTheLoai as List<SelectListItem>)
            {
                <option value="@theLoai.Value">@theLoai.Text</option>
            }
        </select>
        <button type="button" class="btn btn-sm btn-primary mt-2" onclick="layTheLoai()">Xác nhận</button>
        <input type="text" id="IdTheLoai" name="IdTheLoai" class="form-control mt-2" value="@Model.IdTheLoai" readonly />

        <span asp-validation-for="IdTheLoai" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ThoiLuong">Thời lượng (phút)</label>
        <input asp-for="ThoiLuong" class="form-control" />
        <span asp-validation-for="ThoiLuong" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="NgayKhoiChieu">Ngày khởi chiếu</label>
        <input asp-for="NgayKhoiChieu" type="date" class="form-control" />
        <span asp-validation-for="NgayKhoiChieu" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="MaDoTuoi">Độ tuổi phù hợp</label>
        <input asp-for="MaDoTuoi" class="form-control" />
        <span asp-validation-for="MaDoTuoi" class="text-danger"></span>
    </div>


    <div class="form-group">
        <label>Hình ảnh hiện tại</label><br />
        @if (!string.IsNullOrEmpty(Model.HinhAnh))
        {
            <img id="previewAnh" src="~/images/@Model.HinhAnh" style="height: 200px; object-fit: cover; border-radius: 5px;" />
        }
        else
        {
            <img id="previewAnh" src="~/images/no-image.png" style="height: 200px;" />
        }
    </div>

    <div class="form-group">
        <label>Đổi ảnh mới.</label>
        <input type="file" id="chonFileAnh" class="form-control" accept=".jpg,.jpeg,.png" />
    </div>

    <div class="form-group">
        <input type="text" id="HinhAnh" name="HinhAnh" class="form-control" value="@Model.HinhAnh" readonly />
        <span asp-validation-for="HinhAnh" class="text-danger"></span>
    </div>



    <div class="form-group">
        <label asp-for="MoTa">Mô tả phim</label>
        <textarea asp-for="MoTa" class="form-control" rows="4"></textarea>
        <span asp-validation-for="MoTa" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Lưu thay đổi</button>
    <a asp-action="Movie" asp-controller="CinemaAdmin" class="btn btn-secondary">Hủy</a>
</form>

<script>
    function layTheLoai() {
        const selected = Array.from(document.getElementById("theLoaiSelect").selectedOptions)
            .map(o => o.value)
            .filter(v => v !== "");

        document.getElementById("IdTheLoai").value = selected.join(',');
    }

    // Gán tên file vào input và đổi ảnh preview
    document.getElementById("chonFileAnh").addEventListener("change", function () {
        const fileInput = this;
        if (fileInput.files.length > 0) {
            const file = fileInput.files[0];
            const fileName = file.name;

            // Gán tên file vào input
            document.getElementById("HinhAnh").value = fileName;

            // Hiển thị ảnh mới
            const reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById("previewAnh").src = e.target.result;
            };
            reader.readAsDataURL(file);
        }
    });
</script>

