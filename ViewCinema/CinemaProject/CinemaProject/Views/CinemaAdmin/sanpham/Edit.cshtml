@model CinemaProject.Models.Phim
@{
    ViewData["Title"] = "Chỉnh sửa phim";
    Layout = "~/Views/Shared/LayoutAdmin.cshtml";
}

<h2>Chỉnh sửa thông tin phim</h2>

<form asp-action="EditPhim" asp-controller="CinemaAdmin" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="IdPhim">Mã phim</label>
        <input asp-for="IdPhim" class="form-control" readonly />
    </div>

    <div class="form-group">
        <label asp-for="TenPhim">Tên phim</label>
        <input asp-for="TenPhim" class="form-control" />
        <span asp-validation-for="TenPhim" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="IdTheLoai">Thể loại</label>
        <select asp-for="IdTheLoai" class="form-control" asp-items="ViewBag.IdTheLoai">
            <option value="">-- Chọn thể loại --</option>
        </select>
        <span asp-validation-for="IdTheLoai" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ThoiLuong">Thời lượng (phút)</label>
        <input asp-for="ThoiLuong" class="form-control" />
        <span asp-validation-for="ThoiLuong" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="NgayKhoiChieu">Ngày khởi chiếu</label>
        <input asp-for="NgayKhoiChieu" type="date" class="form-control" />
        <span asp-validation-for="NgayKhoiChieu" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DoTuoiPhuHop">Độ tuổi phù hợp</label>
        <input asp-for="DoTuoiPhuHop" class="form-control" />
        <span asp-validation-for="DoTuoiPhuHop" class="text-danger"></span>
    </div>


    <div class="form-group">
        <label>Hình ảnh hiện tại</label><br />
        @if (!string.IsNullOrEmpty(Model.HinhAnh))
        {
            <img src="~/images/@Model.HinhAnh" style="height: 200px; object-fit: cover; border-radius: 5px;" />
        }
        else
        {
            <p><em>Chưa có hình ảnh</em></p>
        }
    </div>

    <!-- Giữ lại tên ảnh cũ để gán lại nếu không chọn ảnh mới -->
    <input type="hidden" asp-for="HinhAnh" />

    <div class="form-group">
        <label>Đổi ảnh phim (nếu muốn)</label>
        <input type="file" name="HinhAnhFile" class="form-control" accept=".jpg,.jpeg,.png" />
        <small class="form-text text-muted">Bỏ qua nếu không muốn thay đổi ảnh</small>
    </div>


    <div class="form-group">
        <label asp-for="MoTa">Mô tả phim</label>
        <textarea asp-for="MoTa" class="form-control" rows="4"></textarea>
        <span asp-validation-for="MoTa" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Lưu thay đổi</button>
    <a asp-action="Movie" asp-controller="CinemaAdmin" class="btn btn-secondary">Hủy</a>
</form>
