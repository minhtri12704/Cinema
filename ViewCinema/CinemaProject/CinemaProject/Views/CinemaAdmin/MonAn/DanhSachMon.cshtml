@model IEnumerable<CinemaProject.Models.MonAnvaThucUong>
@{
    Layout = "~/Views/Shared/LayoutAdmin.cshtml";
}
<h2>Danh sách món ăn và thức uống</h2>
<a asp-action="CreateMon" class="btn btn-primary mb-3">Thêm mới</a>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Tên món</th>
            <th>Loại</th>
            <th>Giá</th>
            <th>Mô tả</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.TenMon</td>
                <td>@item.Loai</td>
                <td>@item.Gia.ToString("N0") VNĐ</td>
                <td>@item.MoTa</td>
                <td>@(item.TrangThai ? "Hiện" : "Ẩn")</td>
                <td>
                    <a asp-controller="CinemaAdmin" asp-action="EditMon" asp-route-id="@item.MaMon">Sửa</a> |
                    <a asp-controller="CinemaAdmin" asp-action="DeleteMon" asp-route-id="@item.MaMon" onclick="return confirm('Bạn có chắc muốn xoá?');">Xoá</a>
                </td>
            </tr>
        }
    </tbody>
</table>
