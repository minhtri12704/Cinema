@model CinemaProject.Models.MonAnvaThucUong
@{
    Layout = "~/Views/Shared/LayoutAdmin.cshtml";
    ViewData["Title"] = "Sửa món ăn / thức uống";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="EditMon" method="post">
    @* Hidden để giữ MaMon khi post *@
    <input type="hidden" asp-for="MaMon" />

    <div class="form-group">
        <label asp-for="TenMon"></label>
        <input asp-for="TenMon" class="form-control" />
        <span asp-validation-for="TenMon" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Loai"></label>
        <input asp-for="Loai" class="form-control" />
        <span asp-validation-for="Loai" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Gia"></label>
        <input asp-for="Gia" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Gia" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="MoTa"></label>
        <textarea asp-for="MoTa" class="form-control"></textarea>
        <span asp-validation-for="MoTa" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="TrangThai">Hoạt động</label>
        <input asp-for="TrangThai" type="checkbox" />
    </div>

    <button type="submit" class="btn btn-success mt-2">CapNhat</button>
    <a asp-action="DanhSachMon" class="btn btn-secondary mt-2">Quay lại</a>
</form>
