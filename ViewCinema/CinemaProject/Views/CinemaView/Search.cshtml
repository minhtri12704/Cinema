@model List<CinemaProject.Models.Phim>

<h2>Kết quả tìm kiếm</h2>

@if (!Model.Any())
{
    <p>Không tìm thấy phim nào phù hợp.</p>
}
else
{
    <div class="row">
        @foreach (var phim in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100 bg-dark text-white">
                    <img src="~/images/@(phim.TenPhim).jpg" class="card-img-top" style="height:300px; object-fit:cover;" />

                    <div class="card-body">
                        <h5 class="card-title">@phim.TenPhim</h5>
                        <p class="card-text">Thể loại: @phim.IdTheLoai</p>
                        <p class="card-text">Ngày khởi chiếu: @(phim.NgayKhoiChieu?.ToShortDateString() ?? "Chưa có")</p>
                        <a href="@Url.Action("Details", "Phim", new { id = phim.IdPhim })" class="btn btn-primary">Xem chi tiết</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
