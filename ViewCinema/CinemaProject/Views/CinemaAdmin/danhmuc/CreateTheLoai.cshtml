@model CinemaProject.Models.TheLoai
@{
    Layout = "~/Views/Shared/LayoutAdmin.cshtml";
}

<h2>Thêm thể loại</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">Vui lòng kiểm tra lại dữ liệu.</div>
}

<form asp-action="CreateTheLoai" method="post">
    <div class="form-group">
        <label asp-for="IdTheLoai">Mã thể loại</label>
        <input asp-for="IdTheLoai" class="form-control" />
        <span asp-validation-for="IdTheLoai" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="TenTheLoai">Tên thể loại</label>
        <input asp-for="TenTheLoai" class="form-control" />
        <span asp-validation-for="TenTheLoai" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success mt-2">Lưu</button>
</form>
