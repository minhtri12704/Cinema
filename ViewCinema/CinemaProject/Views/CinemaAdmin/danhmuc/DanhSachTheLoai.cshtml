@model IEnumerable<CinemaProject.Models.TheLoai>

@{
    Layout = "~/Views/Shared/LayoutAdmin.cshtml";
}

<h2>Danh sách thể loại</h2>
<a href="@Url.Action("CreateTheLoai", "CinemaAdmin")" class="btn btn-primary mb-3">Thêm thể loại</a>

<table class="table table-dark table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Tên thể loại</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var theLoai in Model)
        {
            <tr>
                <td>@theLoai.IdTheLoai</td>
                <td>@theLoai.TenTheLoai</td>
                <td>
                    <a asp-action="EditTheLoai" asp-route-id="@theLoai.IdTheLoai">Sửa</a> |
                    <a asp-action="DeleteTheLoai" asp-route-id="@theLoai.IdTheLoai">Xoá</a>
                </td>
            </tr>
        }
    </tbody>
</table>
