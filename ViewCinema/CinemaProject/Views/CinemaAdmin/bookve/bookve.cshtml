@model IEnumerable<CinemaProject.Models.BookVe>
@{
    Layout = "~/Views/Shared/LayoutAdmin.cshtml";
}

<h2>Danh sách đặt vé</h2>

<div class="center-table">
    <div class="table-container">
        <table class="table table-bordered table-dark table-hover text-center">
            <thead class="thead-light">
                <tr>
                    <th>ID Đặt Vé</th>
                    <th>Khách Hàng</th>
                    <th>Ghế</th>
                    <th>Thời Gian</th>
                    <th>Trạng Thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(item.TrangThai == "Đã hủy" ? "table-danger" : "table-secondary")">
                        <td>@item.IdBookVe</td>
                        <td>@item.IdKhach</td>
                        <td>@item.GheNgoi</td>
                        <td>@item.ThoiGianDat.ToString("dd/MM/yyyy")</td>
                        <td>@item.TrangThai</td>
                        <td>
                            @if (item.TrangThai != "Đã hủy")
                            {
                                <form asp-action="HuyVe" asp-route-id="@item.IdBookVe" method="post" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Hủy vé</button>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-danger">Đã hủy</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
